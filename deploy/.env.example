# Скопировать на сервер: /var/www/dubovik/.env
# Права: chown root:www-data .env && chmod 640 .env
# (сервис dubovik-contact работает от www-data и должен читать файл)

# Telegram — заявки приходят в ваш чат (достаточно для работы формы)
# Токен бота (@BotFather) + ваш numeric chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (необязательно, если Telegram уже настроен)
# Gmail: smtp.gmail.com:587 + «пароль приложения» (не обычный пароль почты)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=vik9911@gmail.com
SMTP_PASSWORD=
CONTACT_TO_EMAIL=vik9911@gmail.com

CONTACT_API_HOST=127.0.0.1
CONTACT_API_PORT=8099
