[Unit]
Description=Dubovik site contact form API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/dubovik
Environment=DUBOVIK_ENV=/var/www/dubovik/.env
ExecStart=/usr/bin/python3 /var/www/dubovik/contact_api.py
Restart=on-failure
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
